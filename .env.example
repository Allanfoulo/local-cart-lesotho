# Public frontend build value: set to the Convex cloud URL for the target deployment.
# Production builds need this in the Netlify Production environment (Builds scope).
# Keep RESEND_API_KEY, AUTH_EMAIL_FROM, INITIAL_SUPERADMIN_EMAIL, and SITE_URL
# in the corresponding Convex deployment's environment settings, never here.
VITE_CONVEX_URL=
# Browser key for the Google Maps JavaScript API. Restrict by allowed website
# origins and API in Google Cloud Console; do not use a server service key here.
VITE_GOOGLE_MAPS_API_KEY=

